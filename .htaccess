# Jangan tampilkan daftar file
Options -Indexes

# Sementara memakai versi tanpa database (index.html). Versi database tetap bisa dibuka di index.php
DirectoryIndex index.html index.php

# File yang tidak boleh dibuka lewat browser
<FilesMatch "^(schema\.sql|README\.md|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

# Kompres teks supaya lebih cepat terkirim
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# CSS/JS: browser selalu cek versi terbaru (index.html tidak memakai ?v=)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# Cadangan kalau mod_expires tidak aktif (mis. XAMPP bawaan)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
